# Copy to .env and replace every placeholder with real values.
JUMP_VERSION=latest
# Set to a published agent release tag when following latest or a commit SHA.
# Leave empty when JUMP_VERSION is the corresponding v* release image.
JUMP_AGENT_VERSION=
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BROKER_INTERNAL_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Base64 encoding of 32 random bytes: openssl rand -base64 32
JUMP_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
OIDC_ISSUER=https://login.example.com/realms/jump
OIDC_CLIENT_ID=jump
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=https://jump.example.com/auth/callback
PUBLIC_URL=https://jump.example.com
AGENT_URL=https://agent.jump.example.com
ALLOWED_HOSTS=jump.example.com,localhost,127.0.0.1,jump
COOKIE_SECURE=true
# Set to the Jump server's LAN IP when NPM runs on another host.
JUMP_BIND_ADDRESS=127.0.0.1
